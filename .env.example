# 复制为 .env 后按需修改
# 注意：本文件包含密钥，不要提交到版本库

# 必填：JWT 签名密钥
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=please-change-this-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 刷新令牌有效期（分钟，默认 7 天），用于前端无感续期
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# 登录失败限流：同一用户名连续失败超过该次数即锁定一段时间
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900

# 设备 HTTP 上报令牌
DEVICE_INGEST_TOKEN=

# 设备离线判定：超过该秒数没有上报即置为 offline（默认 90）
DEVICE_OFFLINE_SECONDS=90

# 告警阈值默认值（可在平台「告警处理 → 告警规则」页覆盖）
ALERT_TEMP_MIN=-30
ALERT_TEMP_MAX=-5
ALERT_HUMIDITY_MAX=90

# MySQL
MYSQL_ROOT_PASSWORD=root123456
MYSQL_USER=logistics
MYSQL_PASSWORD=logistics123

# EMQX 控制台默认用户 admin 的密码
EMQX_DASH_PASSWORD=public123

# 宿主机端口
HHLG_WEB_PORT=8080
HHLG_API_PORT=8010
HHLG_MYSQL_PORT=3307
HHLG_MQTT_PORT=1884
HHLG_EMQX_DASH_PORT=18084

# 模拟器上报间隔（秒）
PUBLISH_INTERVAL=3
