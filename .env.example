# 复制为 .env 后按需修改
# 注意：本文件包含密钥，不要提交到版本库

# 必填：JWT 签名密钥
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=please-change-this-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 刷新令牌有效期（分钟，默认 7 天），用于前端无感续期
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# 登录失败限流：同一用户名连续失败超过该次数即锁定一段时间
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900

# 设备 HTTP 上报令牌
DEVICE_INGEST_TOKEN=

# 设备离线判定：超过该秒数没有上报即置为 offline（默认 90）
DEVICE_OFFLINE_SECONDS=90

# 告警阈值默认值（可在平台「告警处理 → 告警规则」页覆盖）
ALERT_TEMP_MIN=-30
ALERT_TEMP_MAX=-5
ALERT_HUMIDITY_MAX=90

# 交易：平台佣金率（0.0 ~ 1.0），下单时锁定到订单，finished 时结算
COMMISSION_RATE=0.10

# 支付模式：sandbox=本机模拟收银台（不联网）；off=关闭在线支付，仅线下合同
PAYMENT_MODE=sandbox

# 支付宝应用（生产接入时填写；sandbox 模式下仅用于展示）
ALIPAY_APP_ID=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 支付宝公钥：填写后异步通知强制 RSA2 验签（后台拷贝的裸 base64 或完整 PEM 均可）
ALIPAY_PUBLIC_KEY=
# 可选：支付宝商户号（seller_id），填写后校验通知来源
ALIPAY_SELLER_ID=

# /metrics 抓取令牌：留空不鉴权；填写后需 Authorization: Bearer <token>
METRICS_TOKEN=

# 本地直跑后端（不走 docker compose）时使用；容器内由 compose 自动覆盖
MQTT_HOST=localhost
MQTT_PORT=1883
REDIS_URL=redis://localhost:6379/0
# 允许跨域的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 固件仓库目录（本地默认 iot/firmware/releases；容器内固定 /app/fw/releases）
# FW_REPO_DIR=

# 固件清单签名公钥（Ed25519，裸 base64 或 PEM）：发布机私钥只留在发布环境，
# 后端与设备只配置公钥。留空表示不校验签名（仅限内网调试）。
OTA_PUBLIC_KEY=
# 生产建议 true：未配置公钥或清单未签名时后端直接拒绝下发
OTA_REQUIRE_SIGNATURE=false
# 固件签名私钥种子（Ed25519，hex）：只用于本机/发布机打包，不会注入容器。
# bootstrap.py 首次运行会自动生成；
OTA_SIGNING_KEY=

# MySQL
MYSQL_ROOT_PASSWORD=root123456
MYSQL_USER=logistics
MYSQL_PASSWORD=logistics123

# EMQX 控制台默认用户 admin 的密码
EMQX_DASH_PASSWORD=public123

# 宿主机端口
HHLG_WEB_PORT=8080
HHLG_DEMAND_PORT=8081
HHLG_API_PORT=8010
HHLG_MYSQL_PORT=3307
HHLG_MQTT_PORT=1884
HHLG_EMQX_DASH_PORT=18084

# 模拟器上报间隔（秒）
PUBLISH_INTERVAL=3

# MySQL 备份保留天数（scripts/backup_mysql.py --keep-days）
BACKUP_KEEP_DAYS=7

# 镜像覆盖（release 流水线注入 GHCR 地址；本地留空即用本地构建的镜像）
# HHLG_BACKEND_IMAGE=ghcr.io/<owner>/<repo>-backend:v3.1.0
# HHLG_FRONTEND_IMAGE=ghcr.io/<owner>/<repo>-frontend:v3.1.0
# HHLG_DEMAND_IMAGE=ghcr.io/<owner>/<repo>-demand:v3.1.0
# HHLG_SIMULATOR_IMAGE=ghcr.io/<owner>/<repo>-simulator:v3.1.0

# 前端构建期 npm 源（国内网络加速）
NPM_REGISTRY=https://registry.npmmirror.com
