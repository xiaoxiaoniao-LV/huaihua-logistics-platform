# 日志与临时文件
*.log
*.zip
.DS_Store

# HTTPS 证书（含私钥，禁止入库）
deploy/https/certs/*
!deploy/https/certs/.gitkeep

# MySQL 备份产物
backups/

# 测试覆盖率
.coverage
coverage.xml
htmlcov/

# Blender 渲染预览图（本地产物，可随时重新生成）
assets/previews/

# 编辑器本地配置
.vscode/
.idea/

# 设备预配产物（每台板子的 config.py 含 WiFi/令牌，禁止入库）
iot/firmware/nodes/
