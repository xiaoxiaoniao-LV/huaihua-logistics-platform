# 复制为 .env 后按需修改
DATABASE_URL=mysql+pymysql://logistics:logistics123@localhost:3307/huaihua_logistics?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0
MQTT_HOST=localhost
MQTT_PORT=1883

# 必改：用 `python -c "import secrets;print(secrets.token_urlsafe(48))"` 生成
JWT_SECRET=please-change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 允许跨域的前端源，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 设备 HTTP 上报令牌（请求头 X-Device-Token）；留空则不校验，仅限本地开发
DEVICE_INGEST_TOKEN=
